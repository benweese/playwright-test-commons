{
	"name": "@benweese/playwright-test-commons",
	"version": "0.8.0",
	"description": "Reusable Playwright test framework layer in TypeScript: API client base class, response helpers, strict JSON schema and date validation, and a UI base page.",
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/benweese/playwright-test-commons.git"
	},
	"author": "Ben Weese",
	"license": "MIT",
	"keywords": [
		"api-testing",
		"json-schema",
		"page-object",
		"playwright",
		"test-automation",
		"testing",
		"typescript"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"docs": "typedoc",
		"typecheck": "tsc -p tsconfig.check.json",
		"test": "playwright test",
		"test:coverage": "c8 playwright test",
		"lint": "eslint . && tsc -p tsconfig.check.json",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"prepare": "npm run build"
	},
	"peerDependencies": {
		"@axe-core/playwright": ">=4.10.0",
		"@playwright/test": ">=1.65.0"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"dayjs": "^1.11.23",
		"genson-js": "^0.0.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@types/node": "^26.6.6",
		"c8": "^12.0.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^65.4.5",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"typedoc": "^0.28.20",
		"typescript": "~6.0",
		"typescript-eslint": "^8.72.2"
	},
	"types": "dist/index.d.ts",
	"overrides": {
		"minimatch": "^11.0.7",
		"glob": "^14.0.2",
		"typedoc": {
			"minimatch": "^10.2.5"
		}
	},
	"bin": {
		"check-test-ids": "dist/bin/check-test-ids.js"
	},
	"peerDependenciesMeta": {
		"@axe-core/playwright": {
			"optional": true
		}
	}
}
